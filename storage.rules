rules_version = '2';

// Shared Storage bucket with oxa-ticket-app (same Firebase project,
// "oxa-ticket-app.firebasestorage.app") — oxa-ticket-app doesn't use
// Storage today (no existing storage.rules to merge with), so this is the
// bucket's first rule set. Paste into Firebase Console -> Storage -> Rules
// (same manual-paste workflow as firestore.rules — no firebase-tools in
// this environment, see README.md).
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Duplicated from ../oxa-ticket-app/firestore.rules' isPosterManagement()
    // / isPosterCrew() — Storage rules can't reference Firestore functions,
    // so this is the same claim/allowlist logic reimplemented here. Keep
    // these two in sync with that file if the management email list or the
    // claim check ever changes.
    // orgManagement OR clause added alongside the hardcoded emails —
    // mirrors oxa-ticket-app/firestore.rules' isPosterManagement(). Keep
    // both in sync (see that file's comment on isPosterManagement() for
    // the full rationale).
    function isPosterManagement() {
      return isSignedIn() &&
             (request.auth.token.email.lower() in
               ['info@oxaphangan.com', 'bella.oxaphangan@gmail.com'] ||
              request.auth.token.orgManagement == true);
    }

    function isPosterFieldCrew() {
      return isSignedIn() && request.auth.token.posterCrew == true;
    }

    function isPosterCrew() {
      return isPosterFieldCrew() || isPosterManagement();
    }

    // ---- OXA Employee Portal (separate app, same Firebase project) ----
    // Duplicated from ../oxa-ticket-app/firestore.rules' isPortalManagement()
    // / isEmployeePortalAccess() — same reason as the poster-tour functions
    // above: Storage rules can't reference Firestore rules functions. Keep
    // in sync with that file if the management email list, the claim name,
    // or the claim check ever changes.
    // Same orgManagement OR clause as isPosterManagement() above — keep in
    // sync with oxa-ticket-app/firestore.rules' isPortalManagement().
    function isPortalManagement() {
      return isSignedIn() &&
             (request.auth.token.email.lower() in
               ['info@oxaphangan.com', 'bella.oxaphangan@gmail.com'] ||
              request.auth.token.orgManagement == true);
    }

    function isEmployeePortalAccess() {
      return isSignedIn() &&
             (request.auth.token.employeePortalAccess == true || isPortalManagement());
    }

    // Proof photos only — path shape from lib/storage.ts:
    // posterRounds/{roundKey}/{sellerId}/{timestamp}.jpg
    // Only the field flow (components/SellerQueueCard.tsx) ever uploads;
    // management only ever views (PhotoPreview), so write stays scoped to
    // field crew (the posterCrew claim) rather than isPosterCrew()'s
    // broader OR — no legitimate management-upload use case today.
    match /posterRounds/{roundKey}/{sellerId}/{fileName} {
      allow read: if isPosterCrew();
      allow write: if isPosterFieldCrew();
    }

    // Misc Poster Log photos (lamp posts, taxis, vinyl banner changes —
    // non-sequential entries with no seller record) — path shape from
    // lib/misc-log.ts / lib/storage.ts's uploadMiscLogPhoto:
    // posterRounds/{roundKey}/miscLog/{entryId}/{fileName}
    // entryId is a client-generated Firestore doc ID, not a sellerId. Same
    // crew-write/crew-or-management-read split as the block above.
    match /posterRounds/{roundKey}/miscLog/{entryId}/{fileName} {
      allow read: if isPosterCrew();
      allow write: if isPosterFieldCrew();
    }

    // Group F comment-thread photo attachments — path shape from
    // lib/poster-comments.ts's uploadPosterCommentPhoto:
    // posterComments/{roundKey}/{sellerStatus|miscLog}/{entryId}/{commentId}/
    // {fileName}. Both field crew and management post into the same
    // thread, so (like taskComments in the Employee Portal block below)
    // there's no single owner uid to scope by path — isPosterCrew() already
    // covers both, since isPosterManagement() is part of its OR clause.
    match /posterComments/{roundKey}/{kind}/{entryId}/{commentId}/{fileName} {
      allow read: if isPosterCrew();
      allow write: if isPosterCrew();
    }

    // Report photos (damaged banners, torn posters, bike problems — a
    // persistent record, not round-scoped) — path shape from
    // lib/reports.ts / lib/storage.ts's uploadReportPhoto:
    // posterReports/{reportId}/{fileName}
    // Same crew-write/crew-or-management-read split as the blocks above.
    match /posterReports/{reportId}/{fileName} {
      allow read: if isPosterCrew();
      allow write: if isPosterFieldCrew();
    }

    // Employee Portal check-in/out identity selfies (separate app, same
    // Firebase project) — path shape from oxa-employee-portal/lib/storage.ts:
    // timeSessionPhotos/{sessionId}/{checkin|checkout}.jpg
    // Claim-gated only, same as the three blocks above — not per-session
    // ownership-checked. A true "own session only" read check would need
    // firestore.get() on the matching timeSessions doc, but that doc
    // doesn't exist yet at the moment the check-in photo is uploaded (the
    // photo is uploaded first, then the Firestore doc is created
    // referencing it), so an ownership check would work for checkout
    // photos but not check-in ones — left out for consistency rather than
    // building an asymmetric rule. The Firestore-side create/update rules
    // are what actually enforce resource.data.uid == request.auth.uid.
    match /timeSessionPhotos/{sessionId}/{fileName} {
      allow read: if isPortalManagement() || isEmployeePortalAccess();
      allow write: if isEmployeePortalAccess();
    }

    // Employee self-registration selfie + ID/passport document photos
    // (separate app, same Firebase project) — path shape from
    // oxa-employee-portal/lib/storage.ts:
    // employeeProfiles/{uid}/{selfie|idDocument}.jpg
    // Write also grants isPortalManagement() (not owner-only anymore) —
    // needed for the retroactive ID document upload flow
    // (uploadIdDocumentForEmployee), for employees who registered without
    // their ID/passport ready. The decline flow still deletes both objects
    // server-side via the onEmployeeDeleted Cloud Function under the Admin
    // SDK, bypassing these rules entirely — that part is unaffected. Read
    // is owner-or-management, same shape as timeSessionPhotos above.
    match /employeeProfiles/{uid}/{fileName} {
      allow read: if isPortalManagement() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && (request.auth.uid == uid || isPortalManagement());
    }

    // Anträge Receipt-type request photos (separate app, same Firebase
    // project) — path shape from oxa-employee-portal/lib/storage.ts's
    // uploadReceiptPhoto: antragePhotos/{uid}/{requestId}/receipt.jpg.
    // uid is in the path (rather than requestId alone) specifically so
    // ownership can be checked the simple way, same as employeeProfiles
    // above — no firestore.get() cross-service lookup needed, keeping the
    // "Storage rules can't see Firestore rules functions, and this project
    // avoids firestore.get() ownership checks for consistency" convention
    // intact (see timeSessionPhotos' comment above for why that tradeoff
    // was made there too).
    match /antragePhotos/{uid}/{requestId}/{fileName} {
      allow read: if isPortalManagement() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Aufgaben (Tasks) — separate app, same Firebase project. Task
    // description voice + explanation photo/video, path shape from
    // oxa-employee-portal/lib/storage.ts: taskMedia/{ownerId}/{fileName}
    // (ownerId is a taskTemplates doc id for a routine task, a
    // taskInstances doc id for a one-time task, which has no template, or
    // a fresh taskInstances doc id for a "Report" submission — see that
    // file's comment). write was isPortalManagement()-only until the
    // Report feature (oxa-employee-portal/lib/tasks.ts's
    // submitReportTask) — the one path where an employee creates a
    // taskInstances doc directly, so they need to upload its explanation
    // photo/video/voice here first (same broadening already applied to
    // taskComments' write rule below). The request.resource.size cap
    // applies only to the video file (explanation-video.{ext}) — a fresh,
    // previously-unused mechanism in this rules file (no other path here
    // enforces a size limit), added specifically because mobile video can
    // be large and this project has real weak-connection upload concerns;
    // matches the 20 MB client-side check in oxa-employee-portal's report
    // page. Photos/voice keep their existing no-limit behavior.
    match /taskMedia/{ownerId}/{fileName} {
      allow read: if isPortalManagement() || isEmployeePortalAccess();
      allow write: if (isPortalManagement() || isEmployeePortalAccess()) &&
                   (!fileName.matches('explanation-video[.].*') || request.resource.size < 20 * 1024 * 1024);
    }

    // Completion proof photo — path shape from lib/storage.ts's
    // uploadTaskProofPhoto: taskProofPhotos/{uid}/{instanceId}/proof.jpg.
    // uid is the completing employee's own uid, same owner-in-path
    // convention as antragePhotos/employeeProfiles above — no
    // firestore.get() ownership lookup needed.
    match /taskProofPhotos/{uid}/{instanceId}/{fileName} {
      allow read: if isPortalManagement() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Comment-thread voice/photo attachments — path shape from
    // uploadTaskCommentPhoto/uploadTaskCommentVoice:
    // taskComments/{instanceId}/{commentId}/{fileName}. Both parties post
    // into the same thread, so (unlike the two blocks above) there's no
    // single owner uid to scope by path — claim-gated only, same
    // asymmetric tradeoff already made for timeSessionPhotos above (see
    // that block's comment) rather than a firestore.get() lookup against
    // the parent instance's assignment.
    match /taskComments/{instanceId}/{commentId}/{fileName} {
      allow read: if isPortalManagement() || isEmployeePortalAccess();
      allow write: if isPortalManagement() || isEmployeePortalAccess();
    }
    // ---- OXA Flyer Tours (separate app, same Firebase project) ----
    // Duplicated locally since Storage rules can't reference Firestore
    // rules functions — same pattern as isPosterManagement()/
    // isPortalManagement() above. Keep in sync with firestore.rules'
    // isFlyerAdmin() if the claim name ever changes.
    function isFlyerAdmin() {
      return isSignedIn() &&
             (request.auth.token.flyerAdmin == true ||
              request.auth.token.email.lower() in
                ['info@oxaphangan.com', 'bella.oxaphangan@gmail.com']);
    }

    // Passport photos — path shape: flyerPassports/{token}/passport.jpg
    // get per known token (exact path) is allowed, list (directory
    // enumeration) is admin-only — same "token = access, no browsing"
    // model as the Firestore rules.
    match /flyerPassports/{token}/{fileName} {
      allow get: if true;
      allow list: if isFlyerAdmin();
      allow write: if true;
      allow delete: if isFlyerAdmin();
    }

    // Tour proof photos — path shape: flyerProofs/{token}/{proofId}.jpg
    match /flyerProofs/{token}/{fileName} {
      allow get: if true;
      allow list: if isFlyerAdmin();
      allow write: if true;
      allow delete: if isFlyerAdmin();
    }
  }
}
